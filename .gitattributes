# Force Unix line endings (LF) for all shell scripts and text files
# This prevents Windows CRLF from breaking bash scripts on Linux/Docker

# Shell scripts MUST use LF
*.sh text eol=lf

# Python files use LF
*.py text eol=lf

# YAML files use LF
*.yml text eol=lf
*.yaml text eol=lf

# Other text files use LF
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf

# Binary files - no conversion
*.tar.gz binary
*.gz binary
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
